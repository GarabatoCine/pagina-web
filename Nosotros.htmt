
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nosotros - Garabato Cine</title>

<style>

body{
margin:0;
font-family:Arial, sans-serif;
background:#fff;
color:#111;
}

/* HERO */
.hero img{
width:100%;
height:auto;
display:block;
}

/* SECCIÓN EQUIPO */
.equipo{
display:flex;
gap:30px;
justify-content:center;
padding:60px 20px;
flex-wrap:wrap;
}

.persona{
text-align:center;
max-width:300px;
}

.persona img{
width:100%;
border-radius:10px;
}

.persona h2{
margin:10px 0 5px;
font-size:18px;
}

/* BACKSTAGE */
.backstage{
padding:40px 20px;
}

.backstage h3{
text-align:center;
margin-bottom:30px;
font-size:20px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:15px;
}

.grid img{
width:100%;
border-radius:8px;
object-fit:cover;
}

</style>
</head>

<body>

<!-- HERO -->
<div class="hero">
<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/BANNER%20AFICHES.jpg">
</div>

<!-- EQUIPO -->
<section class="equipo">

<div class="persona">
<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/CARO.jpg">
<h2>Carolina</h2>
<p>Productora</p>
</div>

<div class="persona">
<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/DAVID.jpg">
<h2>David</h2>
<p>Director / Escritor</p>
</div>

</section>

<!-- BACKSTAGE -->
<section class="backstage">

<h3>Detrás de cámaras</h3>

<div class="grid">

<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/BST%20-%20AC.JPG">
<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/BST%20-%20MS1.jpg">
<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/BST%20-%20MS2.jpg">
<img src="https://raw.githubusercontent.com/GarabatoCine/pagina-web/main/Nosotros/BST%20-%20PL.jpg">

</div>

</section>

</body>
</html>
